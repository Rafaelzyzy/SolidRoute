# Endereço IP público ou DDNS do servidor WireGuard (impresso nos scripts Mikrotik)
WG_HOST=seu-ddns-ou-ip-publico.com

# Sub-rede padrão atribuída aos peers pelo WG-Easy
WG_DEFAULT_ADDRESS=10.8.0.x

# Senha em texto plano do WG-Easy (usada pelo backend SolidRoute para autenticar na API)
WG_PASSWORD=admin123

# Hash bcrypt da mesma senha acima (exigido pelo container wg-easy v14)
# Mantenha entre aspas simples no arquivo .env para evitar interpolação de '$' pelo Docker Compose
WG_PASSWORD_HASH='$2a$10$Kt2fRIz5ZwsqqPV40Fu4nu6nlM715TwomK8xD9phtnL46bpqaPlvC'

# Chave secreta para assinatura dos tokens JWT (mínimo 16 caracteres).
# Se deixada em branco, o servidor gera e persiste automaticamente uma chave criptográfica exclusiva em ./data/solidroute/.jwt_secret
JWT_SECRET=

# Credenciais iniciais do administrador (criadas apenas quando o banco está vazio)
ADMIN_DEFAULT_EMAIL=admin@solidroute.com
ADMIN_DEFAULT_PASSWORD=admin123
